# Copy this file to .env.local and fill in real values there.
# .env.local is gitignored; this file (.env.example) is committed, so never put
# real secrets in it.

# Stripe (https://dashboard.stripe.com/apikeys)
# Use your test keys (sk_test_...) while developing, live keys (sk_live_...) in production.
STRIPE_SECRET_KEY=sk_test_...

# Publishable key, exposed to the browser (safe to be public) — powers the embedded
# checkout dialog on /membership/apply and /donate/give. Must be prefixed
# NEXT_PUBLIC_ or Next.js won't include it in the client bundle.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Resend (https://resend.com/api-keys)
RESEND_API_KEY=re_...

# Verified sender address. Until a domain is verified in Resend, leave this unset to use
# Resend's shared sandbox sender ("onboarding@resend.dev"), which only delivers to your own
# Resend account email. Once you verify sanatansamajaus.com.au (or another domain) in Resend,
# set this to e.g. "Sanatan Samaj Australia <membership@sanatansamajaus.com.au>".
RESEND_FROM_EMAIL=

# MongoDB connection string (e.g. from MongoDB Atlas: Database -> Connect -> Drivers).
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=sanatansamaj

# Admin login (/admin/login) — a single fixed account, no sign-up. To rotate the
# password: pick a new one, then run
#   node -e "console.log(require('bcryptjs').hashSync('your-new-password', 12))"
# then paste the resulting hash here with every "$" escaped as "\$" — Next.js's
# env loader otherwise reads "$word" as a variable to interpolate and silently
# drops it, corrupting the hash. Example: "$2b$12$abc..." -> "\$2b\$12\$abc...".
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=\$2b\$12\$...

# Random 32-byte secret used to sign/encrypt NextAuth session tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=
